{
  "name": "siteguard",
  "version": "1.0.0",
  "private": true,
  "description": "Website security auditor on Zoho Catalyst: severity-ranked reports, issue history, scheduled e-mail audits.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "sync": "node scripts/sync-shared.js",
    "gen-schema": "node scripts/gen-schema.js",
    "scan": "node scripts/scan.js",
    "test": "node --test test/*.test.js",
    "predeploy": "npm run sync && npm test"
  },
  "devDependencies": {
    "express": "^4.21.2"
  }
}
