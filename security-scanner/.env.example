# --- Server ---
PORT=3000
# Public base URL used in e-mail links and Stripe redirects
APP_URL=http://localhost:3000
# SQLite file (directory is created automatically)
DATABASE_PATH=./data/siteguard.db
# Set to "production" to mark session cookies Secure
NODE_ENV=development

# --- Scanner ---
# Never enable in production: lets the scanner reach private/loopback addresses (used by tests)
SCANNER_ALLOW_PRIVATE=false
SCANNER_TIMEOUT_MS=10000
AUDIT_CONCURRENCY=3

# --- E-mail (scheduled reports). Without SMTP_HOST, mails are written to ./data/outbox ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SiteGuard <reports@example.com>"

# --- Billing ---
# Stripe Checkout (subscription). Leave empty to disable.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Lets anyone switch plans from the Billing page without paying. Local development only.
BILLING_DEV_MODE=false
